# Tracking
NEXT_PUBLIC_TRACKING_API_URL=https://tracking.example.com
NEXT_PUBLIC_BOOKING_WIDGET_URL=https://booking-widget.example.com

# URLs de las apps POS — usadas por el dropdown "Mis apps" en el navbar.
# Si una variable queda vacía, esa app no aparece en el dropdown.
NEXT_PUBLIC_APP_ADMIN_URL=https://admin.growthsuite.com.mx
NEXT_PUBLIC_APP_CASH_URL=https://cash.growthsuite.com.mx
NEXT_PUBLIC_APP_COMANDERO_URL=https://comandero.growthsuite.com.mx
NEXT_PUBLIC_APP_MONITOR_URL=https://monitor.growthsuite.com.mx
# POS Centro y Repartidor tienen fallback hardcodeado en NavBar.js
# (apuntan a los Vercel de esas apps) — solo hace falta esta variable si
# algún día se mueven a un dominio propio.
NEXT_PUBLIC_APP_CENTRO_URL=https://pos-centro-front.vercel.app/
NEXT_PUBLIC_APP_COURIER_URL=https://poscourierfront.vercel.app/
